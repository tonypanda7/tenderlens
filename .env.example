# ============================================================
# TenderLens — Environment Variables
# Copy this file to .env and fill in your actual values
# ============================================================

# ---------- Gemini 2.5 Flash API ----------
GEMINI_API_KEY=your_gemini_api_key_here

# ---------- OCR Service (Local) ----------
OCR_SERVICE_URL=http://your-separate-ocr-server-ip:8001
# OCR_API_KEY is only needed if you password-protect the OCR container
OCR_API_KEY=your_ocr_api_key_here

# ---------- PostgreSQL ----------
POSTGRES_USER=tenderlens
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=tenderlens
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---------- MinIO (S3-compatible storage) ----------
MINIO_ROOT_USER=tenderlens
MINIO_ROOT_PASSWORD=your_minio_password_here
MINIO_ENDPOINT=storage:9000
MINIO_BUCKET=tenderlens-docs
MINIO_USE_SSL=false

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- Celery ----------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---------- API Service ----------
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
SECRET_KEY=your_secret_key_here

# ---------- Cost Controls ----------
DAILY_SPEND_CAP=10.00
MAX_TOKENS_PER_TENDER=900000
GEMINI_MAX_RETRIES=4

# ---------- Confidence Thresholds ----------
AUTO_APPROVE_CONFIDENCE=0.85
REVIEWER_QUEUE_CONFIDENCE=0.60
FLAG_WITH_IMAGE_CONFIDENCE=0.60

# ---------- Default Scoring Weights (%) ----------
DEFAULT_FINANCIAL_WEIGHT=35
DEFAULT_TECHNICAL_WEIGHT=35
DEFAULT_COMPLIANCE_WEIGHT=20
DEFAULT_OPTIONAL_WEIGHT=10
